<view class="tab-bar">
  <button
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-bar__item {{selected === index ? 'tab-bar__item--active' : ''}}"
    data-index="{{index}}"
    data-path="{{item.pagePath}}"
    bindtap="switchTab"
    aria-role="tab"
    aria-selected="{{selected === index}}"
  >
    <image
      class="tab-bar__icon"
      src="{{selected === index ? item.selectedIconPath : item.iconPath}}"
      mode="aspectFit"
    />
    <text>{{item.text}}</text>
  </button>
</view>
