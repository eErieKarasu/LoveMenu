.recipe-head { align-items: center; }
.detail-title { flex: 1; }
.detail-cover { display: block; width: 100%; height: 506rpx; margin-bottom: 20rpx; border-radius: 30rpx; background: #f1e8de; }
.detail-cover-placeholder { box-sizing: border-box; padding: 32rpx; background: #f5efe7; }
.ingredient-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 0 4rpx 8rpx; }
.ingredient-heading .section-title { margin: 0; }
.inventory-summary { color: #9b5e35; font-size: 22rpx; text-align: right; }
.inventory-summary.ready { color: var(--sage); }
