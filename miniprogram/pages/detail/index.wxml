<view class="screen" wx:if="{{recipe}}">
  <view class="detail-hero">
    <view class="meta-row"><text class="pill accent" wx:for="{{recipe.tags}}" wx:key="*this">{{item}}</text></view>
    <view class="recipe-head">
      <text class="detail-title">{{recipe.name}}</text>
      <button class="round-btn" bindtap="toggleFavorite">{{recipe.favorite ? '♥' : '♡'}}</button>
    </view>
    <image wx:if="{{recipe.image}}" class="detail-cover" src="{{recipe.image}}" mode="aspectFill" aria-label="{{recipe.name}}菜品图片" />
    <image wx:else class="detail-cover detail-cover-placeholder" src="/assets/illustrations/dish-placeholder.svg" mode="aspectFit" aria-label="{{recipe.name}}暂无菜品图片" />
    <view class="stat-grid">
      <view class="stat"><text>准备</text><text class="value">{{recipe.prep}} 分钟</text></view>
      <view class="stat"><text>烹饪</text><text class="value">{{recipe.cook}} 分钟</text></view>
      <view class="stat"><text>难度</text><text class="value">{{recipe.difficulty}}</text></view>
    </view>
  </view>

  <view class="section card">
    <view class="ingredient-heading"><text class="section-title">食材</text><text class="inventory-summary {{recipe.inventorySummary.ready ? 'ready' : ''}}">{{recipe.inventorySummary.text}}</text></view>
    <view class="ingredient-item" wx:for="{{recipe.ingredientItems}}" wx:key="id">
      <view class="dot {{item.stockStatus}}"></view>
      <view class="item-main">
        <text class="name">{{item.name}}</text>
        <text class="note">需要 {{item.quantity}} {{item.unit}} · {{item.stockText}}</text>
      </view>
    </view>
    <text wx:if="{{!recipe.ingredientItems.length}}" class="muted-empty">还没有录入食材</text>
  </view>

  <view class="section card">
    <text class="section-title">做法步骤</text>
    <view class="step-item" wx:for="{{recipe.steps}}" wx:key="id">
      <view class="step-number">{{index + 1}}</view><view class="item-main"><text class="name">{{item.text}}</text><text wx:if="{{item.duration}}" class="note">约 {{item.duration}} 分钟</text></view>
    </view>
    <text wx:if="{{!recipe.steps.length}}" class="muted-empty">还没有录入做法步骤</text>
  </view>

  <view class="section card">
    <text class="section-title">家庭评分</text>
    <view class="score-item" wx:for="{{scores}}" wx:key="name"><view class="dish-mark">{{item.mark}}</view><view class="item-main"><text class="name">{{item.name}}</text><text class="note">{{item.note}}</text></view></view>
  </view>

  <view class="sticky-actions">
    <button class="primary" bindtap="addToday">{{mealTargetLabel ? '加入' + mealTargetLabel : '安排到今天'}}</button>
    <button class="secondary" bindtap="editRecipe">编辑</button>
  </view>
</view>
