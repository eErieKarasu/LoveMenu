.today-screen { padding-top: 28rpx; }
.today-header { align-items: center; min-height: 230rpx; margin: 10rpx 4rpx 34rpx; padding: 12rpx 0 18rpx; }
.today-hero-copy { flex: 1; min-width: 0; }
.today-summary { color: var(--muted); font-size: 26rpx; line-height: 1.55; margin-top: 18rpx; }
.summary-progress { color: var(--accent); font-weight: 800; }
.profile-entry { display: flex; align-items: center; gap: 12rpx; flex: 0 0 auto; min-width: 116rpx; height: 96rpx; min-height: 96rpx; margin-left: 22rpx; padding: 0; border-radius: 48rpx; background: transparent; line-height: 1; }
.profile-avatar { display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; border: 5rpx solid rgba(255,255,255,.9); border-radius: 44rpx; background: linear-gradient(145deg, #f8efe4, #fffdf9); color: var(--ink); font-family: "Songti SC", serif; font-size: 40rpx; font-weight: 800; box-shadow: 0 8rpx 24rpx rgba(75, 52, 34, .13); }
.profile-chevron { color: #968b80; font-family: Arial, sans-serif; font-size: 48rpx; font-weight: 300; }
.profile-entry:active { opacity: .76; transform: scale(.97); }

.meal-list { display: flex; flex-direction: column; gap: 18rpx; }
.meal-card { overflow: hidden; background: rgba(255, 253, 249, .92); border: 1rpx solid rgba(86, 68, 52, .07); border-radius: 32rpx; padding: 26rpx; box-shadow: 0 10rpx 28rpx rgba(75, 52, 34, .05); }
.meal-card.current { border: 2rpx solid rgba(212, 98, 69, .64); background: rgba(255, 253, 249, .99); box-shadow: 0 14rpx 36rpx rgba(100, 65, 44, .08); }
.meal-card-layout { display: grid; grid-template-columns: 92rpx minmax(0, 1fr); gap: 24rpx; }
.meal-icon-wrap { display: flex; align-items: center; justify-content: center; width: 92rpx; height: 92rpx; border-radius: 46rpx; background: #f6efe7; }
.meal-icon-wrap.current { background: #fff0e9; }
.meal-icon { width: 58rpx; height: 58rpx; }
.meal-card-body { min-width: 0; }
.meal-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.meal-title-group { min-width: 0; }
.meal-name-line { display: flex; align-items: center; gap: 12rpx; }
.meal-name { font-family: "Songti SC", serif; font-size: 34rpx; font-weight: 800; }
.meal-time { display: block; color: var(--muted); font-size: 21rpx; margin-top: 4rpx; }
.meal-head-actions { display: flex; align-items: center; gap: 8rpx; }
.meal-status { color: var(--muted); font-size: 22rpx; padding-top: 6rpx; white-space: nowrap; }
.now-pill { background: var(--accent); color: white; border-radius: 999rpx; font-size: 19rpx; font-weight: 700; line-height: 36rpx; padding: 0 13rpx; box-shadow: 0 4rpx 12rpx rgba(212, 98, 69, .18); }
.more-action { width: 50rpx; height: 58rpx; min-height: 58rpx; border-radius: 24rpx; background: transparent; color: var(--ink); font-size: 36rpx; line-height: 52rpx; padding: 0; }
.more-action:active { background: #f1ebe5; transform: scale(.96); }

.today-dish { display: flex; align-items: center; gap: 18rpx; min-height: 150rpx; padding: 20rpx 0 8rpx; }
.today-dish + .today-dish { border-top: 1rpx solid rgba(100, 70, 45, .08); }
.dish-thumb { flex: 0 0 112rpx; width: 112rpx; height: 112rpx; border-radius: 24rpx; background: #f2e8dc; }
.dish-thumb-placeholder { box-sizing: border-box; padding: 8rpx; background: #f5efe7; }
.dish-main { flex: 1; min-width: 0; }
.today-dish .dish-name { font-size: 31rpx; margin-bottom: 8rpx; }
.dish-detail { display: block; overflow: hidden; color: var(--muted); font-size: 21rpx; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }
.dish-chevron { flex: 0 0 auto; color: #9b9187; font-family: Arial, sans-serif; font-size: 52rpx; font-weight: 300; line-height: 1; }
.today-dish:active { opacity: .76; transform: scale(.99); }

.add-dish-action { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 72rpx; margin-top: 8rpx; border: 2rpx dashed rgba(212, 98, 69, .24); border-radius: 20rpx; background: rgba(255, 250, 245, .5); color: var(--accent); font-size: 25rpx; font-weight: 700; line-height: 72rpx; }
.add-dish-action .plus { font-size: 33rpx; font-weight: 400; margin-right: 6rpx; }
.add-dish-action:active { opacity: .72; transform: scale(.985); }

.meal-empty { position: relative; min-height: 144rpx; padding-top: 20rpx; }
.meal-empty-copy { position: relative; z-index: 2; max-width: 350rpx; }
.meal-prompt { display: block; font-size: 28rpx; font-weight: 750; }
.meal-empty-note { display: block; color: var(--muted); font-size: 22rpx; margin-top: 7rpx; }
.meal-illustration { position: absolute; z-index: 1; right: 118rpx; bottom: -8rpx; width: 168rpx; height: 122rpx; opacity: .4; }
.meal-illustration.dinner { width: 162rpx; opacity: .36; }
.meal-cta { position: absolute; z-index: 3; right: 0; bottom: 0; min-width: 154rpx; min-height: 70rpx; border-radius: 20rpx; background: var(--ink); color: #fffaf3; font-size: 24rpx; font-weight: 700; line-height: 70rpx; padding: 0 22rpx; }
.meal-cta:active { opacity: .84; transform: scale(.97); }

.recent-section { margin-top: 38rpx; }
.recent-card { display: flex; align-items: center; gap: 20rpx; min-height: 144rpx; padding: 18rpx 22rpx; border: 1rpx solid rgba(86, 68, 52, .07); border-radius: 30rpx; background: rgba(255, 253, 249, .96); box-shadow: 0 10rpx 30rpx rgba(75, 52, 34, .06); }
.recent-image { flex: 0 0 112rpx; width: 112rpx; height: 112rpx; border-radius: 22rpx; background: #f2e8dc; }
.recent-image-placeholder { box-sizing: border-box; padding: 8rpx; background: #f5efe7; }
.recent-main { flex: 1; min-width: 0; }
.recent-title-line { display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx; }
.recent-name { overflow: hidden; max-width: 240rpx; font-size: 29rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.recent-status { border-radius: 999rpx; background: var(--accent-soft); color: #b45640; font-size: 20rpx; line-height: 38rpx; padding: 0 13rpx; }
.recent-description { display: block; overflow: hidden; color: var(--muted); font-size: 22rpx; line-height: 1.5; margin-top: 10rpx; text-overflow: ellipsis; white-space: nowrap; }
.recent-chevron { flex: 0 0 auto; color: #9b9187; font-family: Arial, sans-serif; font-size: 48rpx; font-weight: 300; line-height: 1; }
.recent-card:active { opacity: .76; transform: scale(.99); }

@media (prefers-reduced-motion: no-preference) {
  .today-dish, .add-dish-action, .meal-cta, .more-action, .profile-entry, .recent-card { transition: transform 180ms ease, opacity 180ms ease, background-color 180ms ease; }
}

@media (max-width: 350px) {
  .meal-card-layout { grid-template-columns: 76rpx minmax(0, 1fr); gap: 18rpx; }
  .meal-icon-wrap { width: 76rpx; height: 76rpx; }
  .meal-icon { width: 48rpx; height: 48rpx; }
  .meal-illustration { display: none; }
}
