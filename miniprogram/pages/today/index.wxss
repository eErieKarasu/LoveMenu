.today-screen { padding-top: 28rpx; }
.today-header { margin-bottom: 24rpx; }
.today-summary { color: var(--muted); font-size: 26rpx; line-height: 1.55; margin-top: 12rpx; }
.summary-progress { color: var(--accent); font-weight: 800; }

.meal-list { display: flex; flex-direction: column; gap: 16rpx; }
.meal-card { overflow: hidden; background: rgba(255, 253, 249, .92); border: 1rpx solid rgba(86, 68, 52, .07); border-radius: 32rpx; padding: 24rpx 26rpx; box-shadow: 0 10rpx 28rpx rgba(75, 52, 34, .05); }
.meal-card.current { border-color: rgba(212, 98, 69, .44); background: rgba(255, 253, 249, .98); box-shadow: 0 12rpx 32rpx rgba(100, 65, 44, .065); }
.meal-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.meal-title-group { min-width: 0; }
.meal-name-line { display: flex; align-items: center; gap: 12rpx; }
.meal-name { font-family: "Songti SC", serif; font-size: 34rpx; font-weight: 800; }
.meal-time { display: block; color: var(--muted); font-size: 21rpx; margin-top: 4rpx; }
.meal-head-actions { display: flex; align-items: center; gap: 8rpx; }
.meal-status { color: var(--muted); font-size: 22rpx; padding-top: 6rpx; }
.now-pill { background: var(--accent-soft); color: #b54c34; border-radius: 999rpx; font-size: 19rpx; font-weight: 700; line-height: 36rpx; padding: 0 13rpx; }
.more-action { width: 50rpx; height: 58rpx; min-height: 58rpx; border-radius: 24rpx; background: transparent; color: var(--ink); font-size: 36rpx; line-height: 52rpx; padding: 0; }
.more-action:active { background: #f1ebe5; transform: scale(.96); }

.today-dish { display: flex; align-items: center; gap: 20rpx; min-height: 150rpx; padding: 20rpx 0 8rpx; }
.today-dish + .today-dish { border-top: 1rpx solid rgba(100, 70, 45, .08); }
.dish-thumb { flex: 0 0 138rpx; width: 138rpx; height: 118rpx; border-radius: 24rpx; background: #f2e8dc; }
.today-dish .dish-mark { flex: 0 0 82rpx; width: 82rpx; height: 82rpx; border-radius: 24rpx; }
.dish-main { flex: 1; min-width: 0; }
.today-dish .dish-name { font-size: 31rpx; margin-bottom: 8rpx; }
.dish-detail { display: block; overflow: hidden; color: var(--muted); font-size: 21rpx; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }
.dish-chevron { flex: 0 0 auto; color: #9b9187; font-family: Arial, sans-serif; font-size: 52rpx; font-weight: 300; line-height: 1; }
.today-dish:active { opacity: .76; transform: scale(.99); }

.add-dish-action { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 72rpx; margin-top: 8rpx; border: 2rpx dashed rgba(212, 98, 69, .24); border-radius: 20rpx; background: rgba(255, 250, 245, .5); color: var(--accent); font-size: 25rpx; font-weight: 700; line-height: 72rpx; }
.add-dish-action .plus { font-size: 33rpx; font-weight: 400; margin-right: 6rpx; }
.add-dish-action:active { opacity: .72; transform: scale(.985); }

.meal-empty { position: relative; min-height: 138rpx; padding-top: 20rpx; }
.meal-empty-copy { position: relative; z-index: 2; max-width: 390rpx; }
.meal-prompt { display: block; font-size: 28rpx; font-weight: 750; }
.meal-empty-note { display: block; color: var(--muted); font-size: 22rpx; margin-top: 7rpx; }
.meal-illustration { position: absolute; z-index: 1; right: 124rpx; bottom: -9rpx; width: 180rpx; height: 126rpx; opacity: .43; }
.meal-illustration.dinner { width: 174rpx; opacity: .38; }
.meal-cta { position: absolute; z-index: 3; right: 0; bottom: 0; min-width: 156rpx; min-height: 70rpx; border-radius: 20rpx; background: var(--ink); color: #fffaf3; font-size: 24rpx; font-weight: 700; line-height: 70rpx; padding: 0 24rpx; }
.meal-cta:active { opacity: .84; transform: scale(.97); }

.grocery-summary { position: relative; overflow: hidden; margin-top: 18rpx; min-height: 184rpx; border: 1rpx solid rgba(105, 129, 106, .24); border-radius: 32rpx; background: linear-gradient(135deg, #f2f4e8, #eef2e8); padding: 24rpx 26rpx; box-shadow: 0 10rpx 26rpx rgba(75, 90, 62, .055); }
.grocery-main-row { position: relative; z-index: 2; display: flex; align-items: center; gap: 18rpx; }
.grocery-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 70rpx; width: 70rpx; height: 70rpx; border-radius: 35rpx; background: var(--sage); }
.grocery-icon image { width: 42rpx; height: 42rpx; }
.grocery-copy { flex: 1; min-width: 0; }
.grocery-title { display: block; color: var(--ink); font-size: 29rpx; font-weight: 800; }
.grocery-note { display: block; color: var(--muted); font-size: 21rpx; margin-top: 4rpx; }
.grocery-link { display: flex; align-items: center; gap: 5rpx; color: #625c54; font-size: 24rpx; }
.link-chevron { font-family: Arial, sans-serif; font-size: 42rpx; line-height: 1; }
.grocery-chips { position: relative; z-index: 2; display: flex; gap: 10rpx; margin-top: 18rpx; }
.grocery-chip { min-width: 76rpx; border: 1rpx solid rgba(105, 129, 106, .24); border-radius: 999rpx; background: rgba(255,255,255,.38); color: #4d554b; font-size: 21rpx; line-height: 46rpx; padding: 0 18rpx; text-align: center; }
.grocery-chip.ready { min-width: 130rpx; }
.grocery-leaves { position: absolute; z-index: 1; right: -24rpx; bottom: -34rpx; width: 190rpx; height: 144rpx; opacity: .34; }
.grocery-summary:active { opacity: .88; transform: scale(.99); }

@media (prefers-reduced-motion: no-preference) {
  .today-dish, .add-dish-action, .meal-cta, .more-action, .grocery-summary { transition: transform 180ms ease, opacity 180ms ease, background-color 180ms ease; }
}
