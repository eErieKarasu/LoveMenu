<view class="screen tab-screen today-screen">
  <view wx:if="{{loading}}" class="loading">正在整理今天的菜单…</view>
  <block wx:else>
    <view class="page-header today-header">
      <view>
        <text class="eyebrow">{{dateLabel}} · 今日菜单</text>
        <text class="title">今天吃什么？</text>
        <text class="subtitle">{{summaryText}}</text>
      </view>
    </view>

    <view class="day-progress" aria-label="今日已安排 {{plannedMealCount}} 餐">
      <view wx:for="{{meals}}" wx:key="key" class="progress-segment {{item.dishes.length ? 'filled' : ''}} {{item.isCurrent ? 'current' : ''}}"></view>
    </view>

    <view class="meal-list">
      <view wx:for="{{meals}}" wx:key="key" class="meal-card {{item.isCurrent ? 'current' : ''}} {{item.dishes.length ? 'planned' : ''}}">
        <view class="meal-card-head">
          <view class="meal-title-group">
            <view class="meal-name-line">
              <text class="meal-name">{{item.label}}</text>
              <text wx:if="{{item.isCurrent}}" class="now-pill">现在</text>
            </view>
            <text class="meal-time">{{item.timeLabel}}</text>
          </view>
          <text class="meal-status">{{item.statusText}}</text>
        </view>

        <block wx:if="{{item.dishes.length}}">
          <view class="today-dish" wx:for="{{item.dishes}}" wx:for-item="dish" wx:key="id">
            <view class="dish-mark">{{dish.initial}}</view>
            <view class="dish-main" bindtap="openRecipe" data-id="{{dish.id}}">
              <text class="dish-name">{{dish.name}}</text>
              <text class="dish-detail">{{dish.categoryLabel}} · {{dish.time}} 分钟 · {{dish.spice}}</text>
            </view>
            <button class="remove-action" catchtap="removeDish" data-id="{{dish.id}}" data-meal="{{item.key}}" aria-label="从{{item.label}}移除{{dish.name}}">×</button>
          </view>
        </block>

        <view wx:else class="meal-empty">
          <view>
            <text class="meal-prompt">{{item.prompt}}</text>
            <text class="meal-empty-note">选一道家里真正想吃的。</text>
          </view>
        </view>

        <button class="meal-action {{item.actionQuiet ? 'quiet' : ''}}" bindtap="goRecipes" data-meal="{{item.key}}">{{item.actionText}}</button>
      </view>
    </view>

    <view wx:if="{{selectedCount}}" class="grocery-summary">
      <view class="grocery-copy">
        <text class="grocery-eyebrow">今日采购</text>
        <text class="grocery-title">一次补齐今天要用的食材</text>
        <text class="grocery-note">已根据库存自动跳过家里已有的。</text>
      </view>
      <button class="primary grocery-action" bindtap="addAllToGrocery">汇总加入采购</button>
    </view>

    <view class="section" wx:if="{{recent.length}}">
      <text class="section-title">{{selectedCount ? '顺手再选一道' : '最近常做'}}</text>
      <scroll-view scroll-x class="scroll-row" enable-flex>
        <view class="mini-card" wx:for="{{recent}}" wx:key="id" bindtap="openRecipe" data-id="{{item.id}}">
          <text class="name">{{item.name}}</text>
          <text class="note">{{item.recent}} · {{item.tagSummary}}</text>
        </view>
      </scroll-view>
    </view>
  </block>
</view>
