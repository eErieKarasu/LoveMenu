<view class="screen tab-screen recipes-screen">
  <view class="page-header recipes-header">
    <view><text class="title">菜谱库</text></view>
    <button class="round-btn add-recipe" bindtap="openEditor" aria-label="新增菜谱">＋</button>
  </view>

  <view wx:if="{{mealTargetLabel}}" class="meal-target-bar">
    <view><text class="target-label">正在安排</text><text class="target-meal">{{mealTargetLabel}}</text></view>
    <button bindtap="clearMealTarget">取消</button>
  </view>

  <view class="search recipe-search">
    <text class="search-mark">⌕</text>
    <input placeholder="搜索菜名、食材或标签" value="{{query}}" bindinput="onSearch" />
  </view>

  <scroll-view scroll-x class="tabs recipe-tabs" enable-flex>
    <button class="inspiration-chip" bindtap="inspire"><text class="spark">✦</text> 灵感</button>
    <button wx:for="{{categories}}" wx:key="*this" class="chip {{category === item ? 'active' : ''}}" data-value="{{item}}" bindtap="selectCategory">{{item}}</button>
  </scroll-view>

  <view wx:if="{{loading}}" class="loading">正在读取菜谱…</view>
  <view wx:elif="{{recipes.length}}" class="recipe-list">
    <view class="visual-recipe-card" wx:for="{{recipes}}" wx:key="id">
      <view class="recipe-card-grid">
        <view class="recipe-media" bindtap="openRecipe" data-id="{{item.id}}" aria-role="button" aria-label="查看{{item.name}}做法">
          <image wx:if="{{item.imageSrc}}" class="recipe-image" src="{{item.imageSrc}}" mode="aspectFill" aria-label="{{item.name}}菜品图片" />
          <image wx:else class="recipe-image recipe-image-placeholder" src="/assets/illustrations/dish-placeholder.svg" mode="aspectFit" aria-label="{{item.name}}暂无菜品图片" />
        </view>

        <view class="recipe-card-content">
          <view class="visual-recipe-head">
            <text class="visual-recipe-name">{{item.name}}</text>
            <button class="favorite-action {{item.favorite ? 'selected' : ''}}" catchtap="toggleFavorite" data-id="{{item.id}}" aria-label="{{item.favorite ? '取消收藏' : '收藏'}}{{item.name}}">{{item.favorite ? '♥' : '♡'}}</button>
          </view>
          <text class="ingredient-preview">{{item.ingredientPreview || '还没有录入食材'}}</text>
          <view class="recipe-meta">
            <text class="pill accent">{{item.typeLabel}}</text>
            <text class="pill">{{item.time}} 分钟</text>
            <text class="pill sage">{{item.difficulty}}</text>
          </view>
          <view class="inventory-strip {{item.inventoryReady ? 'ready' : ''}}" bindtap="openRecipe" data-id="{{item.id}}" aria-role="button" aria-label="查看{{item.name}}的库存匹配">
            <image src="/assets/illustrations/inventory-basket.svg" mode="aspectFit" />
            <text>{{item.inventoryText}}</text>
            <text class="inventory-chevron">›</text>
          </view>
        </view>
      </view>

      <view class="visual-card-footer">
        <button class="method-link" bindtap="openRecipe" data-id="{{item.id}}">查看做法 <text>›</text></button>
        <button class="arrange-action" catchtap="addToday" data-id="{{item.id}}">安排</button>
      </view>
    </view>
  </view>
  <view wx:else class="empty-state"><text class="headline">{{emptyTitle}}</text><text>{{emptyCopy}}</text></view>
</view>
