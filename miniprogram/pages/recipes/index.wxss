.meal-target-bar { display: flex; align-items: center; justify-content: space-between; margin: -8rpx 0 20rpx; padding: 18rpx 22rpx; border-radius: 22rpx; background: var(--accent-soft); color: #a94630; }
.target-label { font-size: 21rpx; margin-right: 10rpx; }
.target-meal { font-size: 27rpx; font-weight: 800; }
.meal-target-bar button { min-height: 52rpx; line-height: 52rpx; border-radius: 999rpx; background: rgba(255,255,255,.58); color: #a94630; font-size: 22rpx; padding: 0 20rpx; }
