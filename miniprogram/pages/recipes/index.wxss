.recipes-screen { padding-top: 28rpx; }
.recipes-header { align-items: center; margin-bottom: 20rpx; }
.add-recipe { background: rgba(255,253,249,.9); }

.meal-target-bar { display: flex; align-items: center; justify-content: space-between; margin: -4rpx 0 16rpx; padding: 16rpx 20rpx; border-radius: 20rpx; background: var(--accent-soft); color: #a94630; }
.target-label { font-size: 21rpx; margin-right: 10rpx; }
.target-meal { font-size: 27rpx; font-weight: 800; }
.meal-target-bar button { min-height: 50rpx; line-height: 50rpx; border-radius: 999rpx; background: rgba(255,255,255,.58); color: #a94630; font-size: 22rpx; padding: 0 20rpx; }

.recipe-search { height: 78rpx; border-radius: 24rpx; padding: 0 22rpx; }
.recipe-search input { height: 76rpx; font-size: 25rpx; }
.search-mark { color: var(--ink); font-size: 34rpx; line-height: 1; }

.recipe-tabs { white-space: nowrap; margin: 14rpx -28rpx 18rpx 0; }
.recipe-tabs .chip, .inspiration-chip { display: inline-flex; vertical-align: middle; align-items: center; justify-content: center; min-height: 58rpx; border-radius: 999rpx; font-size: 24rpx; line-height: 58rpx; padding: 0 23rpx; margin-right: 11rpx; }
.recipe-tabs .chip { background: #eee7df; color: #6e655c; }
.recipe-tabs .chip.active { background: var(--ink); color: white; }
.inspiration-chip { border: 2rpx solid var(--accent); background: rgba(255,253,249,.64); color: var(--accent); font-weight: 700; }
.spark { font-size: 27rpx; margin-right: 6rpx; }

.recipe-list { display: flex; flex-direction: column; gap: 16rpx; }
.visual-recipe-card { overflow: hidden; border: 1rpx solid rgba(86, 68, 52, .07); border-radius: 34rpx; background: rgba(255,253,249,.96); box-shadow: 0 12rpx 32rpx rgba(75,52,34,.06); padding: 20rpx; }
.recipe-card-grid { display: grid; grid-template-columns: 246rpx minmax(0, 1fr); gap: 20rpx; }
.recipe-media { min-width: 0; }
.recipe-image, .recipe-image-fallback { display: flex; align-items: center; justify-content: center; width: 246rpx; height: 250rpx; border-radius: 26rpx; background: #f1e7dc; }
.recipe-image-fallback { flex-direction: column; color: var(--accent); }
.recipe-image-fallback > text:first-child { font-family: "Songti SC", serif; font-size: 70rpx; font-weight: 800; }
.fallback-note { color: var(--muted); font-size: 21rpx; margin-top: 4rpx; }
.recipe-media:active { opacity: .8; transform: scale(.985); }

.recipe-card-content { min-width: 0; }
.visual-recipe-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12rpx; }
.visual-recipe-name { flex: 1; min-width: 0; overflow: hidden; font-family: "Songti SC", serif; font-size: 34rpx; font-weight: 800; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
.favorite-action { flex: 0 0 50rpx; width: 50rpx; height: 50rpx; min-height: 50rpx; border-radius: 25rpx; background: transparent; color: #978d83; font-family: Arial, sans-serif; font-size: 40rpx; line-height: 46rpx; padding: 0; }
.favorite-action.selected { color: var(--accent); }
.favorite-action:active { background: #f0e9e2; transform: scale(.92); }
.ingredient-preview { display: block; overflow: hidden; color: var(--muted); font-size: 23rpx; line-height: 1.45; margin-top: 10rpx; text-overflow: ellipsis; white-space: nowrap; }
.recipe-meta { display: flex; flex-wrap: nowrap; gap: 7rpx; margin-top: 16rpx; }
.recipe-meta .pill { flex: 0 1 auto; overflow: hidden; max-width: 112rpx; font-size: 20rpx; line-height: 40rpx; padding: 0 13rpx; text-overflow: ellipsis; white-space: nowrap; }
.inventory-strip { display: flex; align-items: center; gap: 8rpx; min-width: 0; min-height: 58rpx; margin-top: 18rpx; border-radius: 18rpx; background: #e8f0e5; color: #4f7658; padding: 0 13rpx; }
.inventory-strip image { flex: 0 0 31rpx; width: 31rpx; height: 31rpx; }
.inventory-strip > text:nth-child(2) { flex: 1; min-width: 0; overflow: hidden; font-size: 20rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.inventory-strip.ready { background: #e2eee0; color: #426a4c; }
.inventory-chevron { flex: 0 0 auto; font-family: Arial, sans-serif; font-size: 34rpx; line-height: 1; }
.inventory-strip:active { opacity: .74; transform: scale(.985); }

.visual-card-footer { display: flex; align-items: center; justify-content: space-between; min-height: 70rpx; padding: 12rpx 4rpx 0; }
.method-link { min-height: 56rpx; background: transparent; color: #6f665d; font-size: 23rpx; line-height: 56rpx; padding: 0 12rpx; }
.method-link text { font-family: Arial, sans-serif; font-size: 34rpx; margin-left: 4rpx; }
.arrange-action { min-width: 118rpx; min-height: 66rpx; border-radius: 22rpx; background: var(--accent); color: white; box-shadow: 0 8rpx 18rpx rgba(212,98,69,.18); font-size: 25rpx; font-weight: 700; line-height: 66rpx; padding: 0 24rpx; }
.method-link:active, .arrange-action:active { opacity: .78; transform: scale(.97); }

@media (prefers-reduced-motion: no-preference) {
  .recipe-media, .favorite-action, .inventory-strip, .method-link, .arrange-action, .inspiration-chip { transition: transform 180ms ease, opacity 180ms ease, background-color 180ms ease; }
}
