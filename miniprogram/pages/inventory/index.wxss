.inventory-screen { padding-top: 28rpx; }
.inventory-page-header { align-items: center; margin-bottom: 24rpx; }
.inventory-heading-copy { flex: 1; min-width: 0; }
.inventory-subtitle { display: block; max-width: 570rpx; margin-top: 10rpx; color: var(--muted); font-size: 23rpx; line-height: 1.55; }
.inventory-hero { display: block; width: 100%; padding: 24rpx; border: 1rpx solid rgba(105, 129, 106, .18); border-radius: 32rpx; background: linear-gradient(145deg, #f8fbf5, #e8efe4); color: var(--ink); text-align: left; }
.inventory-hero-summary { display: flex; align-items: center; }
.inventory-leaf { flex: 0 0 76rpx; width: 76rpx; height: 76rpx; margin-right: 18rpx; }
.inventory-total-copy { flex: 1; min-width: 0; }
.inventory-total { font-family: "Songti SC", serif; font-size: 50rpx; font-weight: 800; }
.inventory-unit { font-size: 26rpx; font-weight: 750; }
.inventory-copy { display: block; margin-top: 2rpx; color: #687467; font-size: 21rpx; }
.overview-chevron { color: #776e66; font-family: Arial, sans-serif; font-size: 52rpx; font-weight: 300; }
.inventory-hero:active { opacity: .8; transform: scale(.992); }

.inventory-metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; margin-top: 20rpx; }
.inventory-metric { display: flex; align-items: center; gap: 10rpx; min-width: 0; min-height: 94rpx; padding: 14rpx 12rpx; border-radius: 22rpx; background: rgba(255,255,255,.66); }
.inventory-metric image { flex: 0 0 46rpx; width: 46rpx; height: 46rpx; }
.inventory-metric > view { min-width: 0; }
.metric-title { display: flex; align-items: baseline; gap: 7rpx; white-space: nowrap; }
.metric-title .value { color: var(--sage); font-size: 29rpx; font-weight: 850; }
.metric-title .name { font-size: 20rpx; font-weight: 750; }
.inventory-metric.low .value { color: #c56d28; }
.inventory-metric.out .value { color: #8c8178; }
.metric-note { display: block; overflow: hidden; margin-top: 4rpx; color: var(--muted); font-size: 17rpx; text-overflow: ellipsis; white-space: nowrap; }

.inventory-form { margin-top: 20rpx; }
.form-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; font-size: 31rpx; font-weight: 800; }
.form-heading button { width: 52rpx; min-height: 52rpx; padding: 0; background: transparent; color: var(--muted); font-size: 36rpx; line-height: 52rpx; }
.stock-level-picker { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; margin-bottom: 22rpx; padding: 8rpx; border-radius: 20rpx; background: #f3eee7; }
.level-option { min-height: 64rpx; padding: 0; border-radius: 15rpx; background: transparent; color: var(--muted); font-size: 24rpx; line-height: 64rpx; }
.level-option.active { background: var(--paper); color: var(--ink); font-weight: 800; box-shadow: 0 5rpx 16rpx rgba(75, 52, 34, .08); }
.inventory-form-grid { display: grid; grid-template-columns: 1.2fr .8fr; gap: 14rpx; }
.inventory-form-grid .category-field { grid-column: 1 / -1; }
.picker-value { line-height: 44rpx; color: var(--ink); }

.inventory-search-row { display: grid; grid-template-columns: minmax(0, 1fr) 126rpx; gap: 12rpx; margin-top: 22rpx; }
.inventory-search { height: 76rpx; padding: 0 20rpx; }
.inventory-search image { width: 31rpx; height: 31rpx; }
.inventory-search input { height: 74rpx; font-size: 24rpx; }
.filter-trigger { display: flex; align-items: center; justify-content: center; gap: 9rpx; min-height: 76rpx; padding: 0 18rpx; border: 1rpx solid var(--line); border-radius: 23rpx; background: var(--paper); color: var(--ink); font-size: 24rpx; line-height: 76rpx; }
.filter-trigger image { width: 29rpx; height: 29rpx; }
.filter-trigger.active { border-color: rgba(212, 98, 69, .46); color: var(--accent); }

.inventory-filter-panel { margin-top: 12rpx; padding: 22rpx; border: 1rpx solid var(--line); border-radius: 26rpx; background: rgba(255,253,249,.96); box-shadow: 0 10rpx 28rpx rgba(75,52,34,.05); }
.filter-panel-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; font-weight: 800; }
.filter-panel-heading button { min-height: 46rpx; padding: 0 8rpx; background: transparent; color: var(--accent); font-size: 21rpx; line-height: 46rpx; }
.filter-label { display: block; color: var(--muted); font-size: 21rpx; margin-bottom: 9rpx; }
.filter-label.record-label { margin-top: 16rpx; }
.filter-options { display: flex; flex-wrap: wrap; gap: 8rpx; }
.filter-option { min-height: 50rpx; padding: 0 17rpx; border-radius: 999rpx; background: #f0ebe5; color: #6e655c; font-size: 21rpx; line-height: 50rpx; }
.filter-option.active { background: var(--ink); color: white; }

.inventory-toolbar { display: flex; align-items: center; gap: 14rpx; margin-top: 14rpx; }
.inventory-tabs { flex: 1; min-width: 0; white-space: nowrap; }
.inventory-tabs .chip { min-height: 56rpx; padding: 0 21rpx; font-size: 22rpx; line-height: 56rpx; margin-right: 8rpx; }
.sort-trigger { flex: 0 0 auto; min-height: 56rpx; padding: 0 5rpx 0 14rpx; background: transparent; color: var(--muted); font-size: 21rpx; line-height: 56rpx; white-space: nowrap; }
.sort-trigger text { margin-left: 4rpx; }

.inventory-list-card { overflow: hidden; margin-top: 14rpx; padding: 0 20rpx; border: 1rpx solid rgba(86,68,52,.07); border-radius: 30rpx; background: rgba(255,253,249,.96); box-shadow: 0 9rpx 26rpx rgba(75,52,34,.045); }
.inventory-row { display: flex; align-items: center; gap: 16rpx; min-height: 110rpx; padding: 17rpx 0; border-bottom: 1rpx solid var(--line); }
.inventory-row:last-child { border-bottom: 0; }
.inventory-mark { display: flex; align-items: center; justify-content: center; flex: 0 0 58rpx; width: 58rpx; height: 58rpx; border-radius: 18rpx; background: var(--sage-soft); color: var(--sage); font-size: 27rpx; font-weight: 800; }
.inventory-mark.low { background: #f7eadb; color: #a6622d; }
.inventory-mark.out { background: #eee9e4; color: #8c8178; }
.inventory-main { flex: 1; min-width: 0; }
.inventory-name-row { display: flex; align-items: center; gap: 9rpx; }
.inventory-name { overflow: hidden; font-size: 27rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.stock-badge { flex: 0 0 auto; padding: 2rpx 10rpx; border-radius: 999rpx; background: var(--sage-soft); color: #506d52; font-size: 18rpx; }
.stock-badge.low { background: #f7eadb; color: #9c5b29; }
.stock-badge.out { background: #eee9e4; color: #81766d; }
.inventory-note { display: block; margin-top: 6rpx; color: var(--muted); font-size: 20rpx; }
.inventory-row-actions { display: flex; align-items: center; gap: 8rpx; flex: 0 0 auto; }
.quantity-stepper { display: inline-flex; align-items: center; gap: 4rpx; padding: 4rpx; border: 1rpx solid var(--line); border-radius: 18rpx; background: #f2ede7; }
.quantity-stepper button { width: 44rpx; height: 44rpx; min-height: 44rpx; padding: 0; border-radius: 14rpx; background: var(--paper); color: var(--ink); font-size: 26rpx; line-height: 44rpx; }
.quantity-stepper text { min-width: 68rpx; font-size: 21rpx; font-weight: 750; text-align: center; }
.item-more { flex: 0 0 50rpx; width: 50rpx; height: 50rpx; min-height: 50rpx; padding: 0; border-radius: 25rpx; background: #f3eee8; color: var(--ink); font-family: Arial, sans-serif; font-size: 28rpx; line-height: 42rpx; letter-spacing: 1rpx; }
.item-more:active, .quantity-stepper button:active { opacity: .7; transform: scale(.92); }

.inventory-add-area { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; min-height: 106rpx; margin-top: 18rpx; padding: 14rpx; border: 2rpx dashed #d9c8b9; border-radius: 24rpx; background: rgba(255,253,249,.52); color: var(--accent); }
.add-area-title { display: block; font-size: 25rpx; font-weight: 750; }
.add-circle { display: inline-flex; align-items: center; justify-content: center; width: 28rpx; height: 28rpx; border: 2rpx solid var(--accent); border-radius: 14rpx; font-size: 23rpx; line-height: 24rpx; }
.add-area-note { display: block; margin-top: 7rpx; color: var(--muted); font-size: 20rpx; }
.inventory-add-area:active { opacity: .72; transform: scale(.992); }
.inventory-tip { display: flex; align-items: center; gap: 10rpx; margin-top: 18rpx; padding: 16rpx 18rpx; border-radius: 20rpx; background: rgba(255,253,249,.5); color: var(--muted); font-size: 19rpx; line-height: 1.5; }
.inventory-tip image { flex: 0 0 30rpx; width: 30rpx; height: 30rpx; }
.tip-strong { color: var(--ink); font-weight: 750; }
.empty-state { padding: 48rpx 30rpx 30rpx; }

@media (prefers-reduced-motion: no-preference) {
  .inventory-hero, .filter-trigger, .filter-option, .quantity-stepper button, .item-more, .inventory-add-area { transition: transform 180ms ease, opacity 180ms ease, background-color 180ms ease; }
}
