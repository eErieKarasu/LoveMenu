.inventory-hero {
  padding: 30rpx;
  border: 1rpx solid rgba(105, 129, 106, .16);
  border-radius: 34rpx;
  background: linear-gradient(145deg, #f8fbf5, #e6eee1);
}
.inventory-total { font-family: "Songti SC", serif; font-size: 58rpx; font-weight: 800; }
.inventory-unit { color: var(--muted); font-weight: 700; }
.inventory-copy { display: block; margin-top: 8rpx; color: #687467; font-size: 24rpx; line-height: 1.6; }
.inventory-metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; margin-top: 24rpx; }
.inventory-metrics view { padding: 18rpx; border-radius: 20rpx; background: rgba(255,255,255,.58); }
.inventory-metrics text { display: block; }
.inventory-metrics .value { color: var(--sage); font-size: 32rpx; font-weight: 800; }
.inventory-metrics .value.warn { color: #b36f36; }
.inventory-metrics .value.muted { color: #8c8178; }
.inventory-metrics .name { margin-top: 3rpx; color: var(--muted); font-size: 21rpx; }
.inventory-form { margin-top: 22rpx; }
.form-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; font-size: 31rpx; font-weight: 800; }
.form-heading button { width: 52rpx; min-height: 52rpx; padding: 0; background: transparent; color: var(--muted); font-size: 36rpx; line-height: 52rpx; }
.stock-level-picker { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; margin-bottom: 22rpx; padding: 8rpx; border-radius: 20rpx; background: #f3eee7; }
.level-option { min-height: 64rpx; padding: 0; border-radius: 15rpx; background: transparent; color: var(--muted); font-size: 24rpx; line-height: 64rpx; }
.level-option.active { background: var(--paper); color: var(--ink); font-weight: 800; box-shadow: 0 5rpx 16rpx rgba(75, 52, 34, .08); }
.inventory-form-grid { display: grid; grid-template-columns: 1.2fr .8fr; gap: 14rpx; }
.inventory-form-grid .category-field { grid-column: 1 / -1; }
.picker-value { line-height: 44rpx; color: var(--ink); }
.inventory-search { margin-top: 24rpx; }
.inventory-tabs { margin-top: 18rpx; }
.inventory-list { overflow: hidden; border-top: 1rpx solid var(--line); }
.inventory-row { display: flex; align-items: flex-start; gap: 16rpx; padding: 24rpx 4rpx; border-bottom: 1rpx solid var(--line); }
.inventory-mark { display: flex; align-items: center; justify-content: center; flex: 0 0 66rpx; width: 66rpx; height: 66rpx; border-radius: 22rpx; background: var(--sage-soft); color: var(--sage); font-weight: 800; }
.inventory-mark.low { background: #f7eadb; color: #a6622d; }
.inventory-mark.out { background: #eee9e4; color: #8c8178; }
.inventory-main { flex: 1; min-width: 0; }
.inventory-name-row { display: flex; align-items: center; gap: 10rpx; }
.inventory-name { font-size: 30rpx; font-weight: 800; }
.stock-badge { padding: 3rpx 12rpx; border-radius: 999rpx; background: var(--sage-soft); color: #506d52; font-size: 20rpx; }
.stock-badge.low { background: #f7eadb; color: #9c5b29; }
.stock-badge.out { background: #eee9e4; color: #81766d; }
.inventory-note { display: block; margin-top: 7rpx; color: var(--muted); font-size: 22rpx; }
.quantity-stepper { display: inline-flex; align-items: center; gap: 10rpx; margin-top: 13rpx; padding: 5rpx; border-radius: 16rpx; background: #eee8e0; }
.quantity-stepper button { width: 48rpx; height: 48rpx; min-height: 48rpx; padding: 0; border-radius: 12rpx; background: var(--paper); color: var(--ink); line-height: 48rpx; }
.quantity-stepper text { min-width: 88rpx; font-size: 22rpx; font-weight: 700; text-align: center; }
.start-tracking { width: auto; min-height: 48rpx; margin-top: 9rpx; padding: 0; background: transparent; color: var(--sage); font-size: 21rpx; line-height: 48rpx; text-align: left; }
.inventory-actions { flex: 0 0 132rpx; }
.inventory-actions button { width: 100%; min-height: 54rpx; padding: 0 8rpx; background: transparent; font-size: 21rpx; line-height: 54rpx; }
.state-action { color: var(--accent); }
.remove-action { color: var(--muted); }
.empty-action { margin: 30rpx auto 0; }
