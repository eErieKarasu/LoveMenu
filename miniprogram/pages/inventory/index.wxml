<view class="screen tab-screen inventory-screen">
  <view class="page-header inventory-page-header">
    <view class="inventory-heading-copy">
      <text class="eyebrow">家里现在有什么</text>
      <text class="title">家庭库存</text>
      <text class="inventory-subtitle">记录家中现有食材，帮你决定今天吃什么、需要买什么。</text>
    </view>
  </view>

  <button class="inventory-hero" bindtap="openOverview" aria-label="查看库存总览">
    <view class="inventory-hero-summary">
      <image class="inventory-leaf" src="/assets/icons/inventory-leaf.svg" mode="aspectFit" />
      <view class="inventory-total-copy">
        <view><text class="inventory-total">{{summary.total}}</text><text class="inventory-unit"> 种食材</text></view>
        <text class="inventory-copy">共记录 {{summary.total}} 种食材</text>
      </view>
      <text class="overview-chevron">›</text>
    </view>
    <view class="inventory-metrics">
      <view class="inventory-metric enough">
        <image src="/assets/icons/inventory-status-enough.svg" mode="aspectFit" />
        <view><view class="metric-title"><text class="value">{{summary.enough}}</text><text class="name">充足</text></view><text class="metric-note">库存充足</text></view>
      </view>
      <view class="inventory-metric low">
        <image src="/assets/icons/inventory-status-low.svg" mode="aspectFit" />
        <view><view class="metric-title"><text class="value">{{summary.low}}</text><text class="name">不多了</text></view><text class="metric-note">建议尽快补充</text></view>
      </view>
      <view class="inventory-metric out">
        <image src="/assets/icons/inventory-status-out.svg" mode="aspectFit" />
        <view><view class="metric-title"><text class="value">{{summary.out}}</text><text class="name">用完</text></view><text class="metric-note">需要购买</text></view>
      </view>
    </view>
  </button>

  <view wx:if="{{adding}}" class="card inventory-form">
    <view class="form-heading"><text>{{editingId ? '编辑食材' : '记录一种食材'}}</text><button bindtap="cancelAdd" aria-label="关闭表单">×</button></view>
    <view class="field"><text class="label">食材名称</text><input class="input" value="{{form.name}}" placeholder="例如：鸡蛋" data-field="name" bindinput="updateForm" /></view>
    <view class="stock-level-picker">
      <button class="level-option {{form.level === 'enough' ? 'active' : ''}}" data-value="enough" bindtap="selectLevel">充足</button>
      <button class="level-option {{form.level === 'low' ? 'active' : ''}}" data-value="low" bindtap="selectLevel">不多了</button>
      <button class="level-option {{form.level === 'out' ? 'active' : ''}}" data-value="out" bindtap="selectLevel">用完</button>
    </view>
    <view class="inventory-form-grid">
      <view class="field"><text class="label">数量（可不填）</text><input class="input" type="digit" value="{{form.quantity}}" placeholder="不填则按状态记录" data-field="quantity" bindinput="updateForm" /></view>
      <view class="field"><text class="label">单位</text><picker mode="selector" range="{{units}}" value="{{form.unitIndex}}" bindchange="changeUnit"><view class="input picker-value">{{form.unit}}⌄</view></picker></view>
      <view class="field category-field"><text class="label">分类</text><picker mode="selector" range="{{categories}}" value="{{form.categoryIndex}}" bindchange="changeCategory"><view class="input picker-value">{{form.category}}⌄</view></picker></view>
    </view>
    <button class="primary" bindtap="saveItem">{{editingId ? '保存更改' : '保存到库存'}}</button>
  </view>

  <view class="inventory-search-row">
    <view class="search inventory-search"><image src="/assets/icons/inventory-search.svg" mode="aspectFit" /><input placeholder="搜索食材名称" value="{{query}}" bindinput="onSearch" /></view>
    <button class="filter-trigger {{filterActive ? 'active' : ''}}" bindtap="toggleFilterPanel"><text>筛选</text><image src="/assets/icons/inventory-filter.svg" mode="aspectFit" /></button>
  </view>

  <view wx:if="{{filterOpen}}" class="inventory-filter-panel">
    <view class="filter-panel-heading"><text>筛选库存</text><button bindtap="resetAdvancedFilter">重置</button></view>
    <text class="filter-label">食材类别</text>
    <view class="filter-options"><button wx:for="{{categoryOptions}}" wx:key="label" class="filter-option {{item.active ? 'active' : ''}}" data-value="{{item.label}}" bindtap="selectCategoryFilter">{{item.label}}</button></view>
    <text class="filter-label record-label">记录方式</text>
    <view class="filter-options"><button wx:for="{{trackingOptions}}" wx:key="value" class="filter-option {{item.active ? 'active' : ''}}" data-value="{{item.value}}" bindtap="selectTrackingFilter">{{item.label}}</button></view>
  </view>

  <view class="inventory-toolbar">
    <scroll-view scroll-x class="inventory-tabs" enable-flex><button wx:for="{{filters}}" wx:key="value" class="chip {{item.active ? 'active' : ''}}" data-value="{{item.value}}" bindtap="selectFilter">{{item.label}}</button></scroll-view>
    <button class="sort-trigger" bindtap="openSort">{{sortLabel}} <text>⌄</text></button>
  </view>

  <view wx:if="{{loading}}" class="loading">正在整理家庭库存…</view>
  <view wx:elif="{{items.length}}" class="inventory-list-card">
    <view class="inventory-row" wx:for="{{items}}" wx:key="id">
      <view class="inventory-mark {{item.level}}">{{item.mark}}</view>
      <view class="inventory-main">
        <view class="inventory-name-row"><text class="inventory-name">{{item.name}}</text><text class="stock-badge {{item.level}}">{{item.levelLabel}}</text></view>
        <text class="inventory-note">{{item.category}} · {{item.recordLabel}}</text>
      </view>
      <view class="inventory-row-actions">
        <view wx:if="{{item.tracked}}" class="quantity-stepper">
          <button data-id="{{item.id}}" data-delta="-1" bindtap="adjustQuantity" aria-label="减少{{item.name}}">−</button>
          <text>{{item.quantity}} {{item.unit}}</text>
          <button data-id="{{item.id}}" data-delta="1" bindtap="adjustQuantity" aria-label="增加{{item.name}}">＋</button>
        </view>
        <button class="item-more" data-id="{{item.id}}" bindtap="openItemMenu" aria-label="管理{{item.name}}">···</button>
      </view>
    </view>
  </view>
  <view wx:else class="empty-state"><text class="headline">{{summary.total ? '没有符合条件的食材' : '库存还是空的'}}</text><text>{{summary.total ? '换个状态、筛选条件或关键词看看。' : '先记录几样常用食材，菜谱就能自动判断缺什么。'}}</text></view>

  <button class="inventory-add-area" bindtap="openAddOptions">
    <text class="add-area-title"><text class="add-circle">＋</text> 添加食材</text>
    <text class="add-area-note">手动添加或从采购清单导入</text>
  </button>

  <view class="inventory-tip"><image src="/assets/icons/inventory-tip.svg" mode="aspectFit" /><text><text class="tip-strong">小提示：</text>库存状态会帮助你更好地选择今天吃什么和需要购买的食材。</text></view>
</view>
