<view class="screen tab-screen">
  <view class="page-header">
    <view><text class="title">采购清单</text></view>
    <button class="round-btn" bindtap="completePurchased">✓</button>
  </view>
  <view wx:if="{{loading}}" class="loading">正在整理采购清单…</view>
  <block wx:elif="{{groups.length}}">
    <view wx:for="{{groups}}" wx:key="name">
      <view class="group-title"><text class="name">{{item.name}}</text><text class="count">{{item.items.length}} 项</text></view>
      <view class="card">
        <view class="grocery-item {{food.checked ? 'checked' : ''}}" wx:for="{{item.items}}" wx:for-item="food" wx:key="id">
          <button class="check-box {{food.checked ? 'checked' : ''}}" bindtap="toggleItem" data-id="{{food.id}}">✓</button>
          <view class="grocery-main">
            <view class="grocery-title"><text class="grocery-name">{{food.name}}</text><text class="grocery-amount">× {{food.quantityText}}</text></view>
            <text class="grocery-source">来自：{{food.sourceText}}</text>
          </view>
        </view>
      </view>
    </view>
    <button class="primary" style="margin-top: 30rpx" bindtap="copyList">复制未购买清单</button>
    <text class="grocery-hint">勾选买到的食材，再点右上角即可一起加入库存。</text>
  </block>
  <view wx:else class="empty-state"><text class="headline">采购清单已清空</text><text>今日菜单中有缺少的食材时，会在这里自动生成。</text></view>
</view>
