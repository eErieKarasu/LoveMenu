.share-screen { padding-top: 54rpx; }
.share-hero { padding: 30rpx 10rpx 36rpx; }
.share-summary { display: block; margin-top: 18rpx; color: var(--muted); font-size: 25rpx; }
.share-meals { display: flex; flex-direction: column; gap: 18rpx; }
.share-meal { padding: 28rpx; border: 1rpx solid rgba(86, 68, 52, .08); border-radius: 30rpx; background: var(--paper); box-shadow: 0 12rpx 34rpx rgba(75, 52, 34, .06); }
.share-meal-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.share-meal-name { font-family: "Songti SC", serif; font-size: 34rpx; font-weight: 800; }
.share-meal-count { color: var(--muted); font-size: 22rpx; }
.shared-dish { display: flex; align-items: center; min-height: 74rpx; border-top: 1rpx solid var(--line); }
.shared-dot { flex: 0 0 14rpx; width: 14rpx; height: 14rpx; margin-right: 18rpx; border-radius: 7rpx; background: var(--accent); }
.shared-name { flex: 1; min-width: 0; font-size: 28rpx; font-weight: 700; }
.shared-time { color: var(--muted); font-size: 22rpx; }
.shared-more { display: block; padding-top: 14rpx; color: var(--accent); font-size: 21rpx; }
.shared-empty { display: block; padding: 14rpx 0 4rpx; color: var(--muted); }
.share-actions { display: flex; flex-direction: column; gap: 14rpx; margin-top: 34rpx; }
.share-footnote { display: block; padding: 28rpx 0; color: var(--muted); font-size: 21rpx; text-align: center; }
.empty-action { margin-top: 36rpx; }
