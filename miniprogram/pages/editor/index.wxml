<view class="screen">
  <view class="page-header"><view><text class="eyebrow">{{id ? '更新家常菜' : '记录家常菜'}}</text><text class="title">{{id ? '编辑菜谱' : '新增菜品'}}</text></view></view>
  <view class="card form-card">
    <view class="field"><text class="label">菜名 *</text><input class="input {{nameError ? 'error' : ''}}" value="{{form.name}}" placeholder="请输入菜名" data-field="name" bindinput="updateField" /></view>
    <view class="field"><text class="label">分类</text><view class="meta-row"><button wx:for="{{dishCategories}}" wx:key="name" class="chip {{item.active ? 'active' : ''}}" data-value="{{item.name}}" bindtap="toggleCategory">{{item.name}}</button></view></view>
    <view class="field time-field">
      <text class="label">准备</text>
      <view class="time-control">
        <button class="time-step" data-field="prep" data-delta="-1" bindtap="adjustTime">−</button>
        <view class="time-value"><text class="time-number">{{form.prep}}</text><text>分钟</text></view>
        <button class="time-step" data-field="prep" data-delta="1" bindtap="adjustTime">＋</button>
      </view>
    </view>
    <view class="field time-field">
      <text class="label">烹饪</text>
      <view class="time-control">
        <button class="time-step" data-field="cook" data-delta="-1" bindtap="adjustTime">−</button>
        <view class="time-value"><text class="time-number">{{form.cook}}</text><text>分钟</text></view>
        <button class="time-step" data-field="cook" data-delta="1" bindtap="adjustTime">＋</button>
      </view>
    </view>
    <view class="field"><text class="label">难度</text><view class="meta-row"><button wx:for="{{difficulties}}" wx:key="*this" class="chip {{form.difficulty === item ? 'active' : ''}}" data-value="{{item}}" bindtap="setDifficulty">{{item}}</button></view></view>
  </view>
  <view class="card form-card">
    <view class="field ingredient-field">
      <text class="label">食材</text>
      <view class="ingredient-list">
        <view class="ingredient-row" wx:for="{{form.ingredientItems}}" wx:key="id">
          <input class="ingredient-name" value="{{item.name}}" placeholder="食材名称" data-index="{{index}}" data-field="name" bindinput="updateIngredient" />
          <view class="ingredient-amount">
            <input class="quantity-input" type="digit" value="{{item.quantity}}" data-index="{{index}}" data-field="quantity" bindinput="updateIngredient" />
            <picker mode="selector" range="{{ingredientUnits}}" value="{{item.unitIndex}}" data-index="{{index}}" bindchange="changeIngredientUnit">
              <view class="unit-picker">{{item.unit}}⌄</view>
            </picker>
          </view>
          <button class="stock-toggle {{item.inStock ? 'active' : ''}}" data-index="{{index}}" bindtap="toggleIngredientStock">
            <text>家里有</text><text class="stock-dot"></text>
          </button>
          <button class="ingredient-remove" data-index="{{index}}" bindtap="removeIngredient">×</button>
        </view>
      </view>
      <button class="add-ingredient" bindtap="addIngredient">＋ 添加食材</button>
    </view>
  </view>
  <view class="card form-card">
    <view class="field step-field">
      <text class="label">做法步骤</text>
      <view class="step-list">
        <view class="step-edit-row" wx:for="{{form.steps}}" wx:key="id">
          <view class="step-edit-number">{{index + 1}}</view>
          <textarea class="step-input" auto-height maxlength="-1" value="{{item.text}}" placeholder="描述这一步怎么做" data-index="{{index}}" bindinput="updateStep" />
          <button class="step-remove" data-index="{{index}}" bindtap="removeStep">×</button>
        </view>
      </view>
      <button class="add-step" bindtap="addStep">＋ 添加步骤</button>
    </view>
  </view>
  <view class="save-bar"><button class="secondary" bindtap="cancel">取消</button><button class="primary" bindtap="save">保存菜谱</button></view>
</view>
