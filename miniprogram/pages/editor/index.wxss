.image-field { margin-bottom: 30rpx; }

.image-label-line {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.image-label-line .label { margin-bottom: 0; }
.optional-label { color: var(--muted); font-size: 22rpx; }

.image-picker {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  min-height: 162rpx;
  padding: 22rpx 28rpx;
  border: 2rpx dashed #d9c8b9;
  border-radius: 24rpx;
  background: #fbf8f4;
  color: var(--ink);
  text-align: left;
}

.image-picker image { flex: 0 0 96rpx; width: 96rpx; height: 96rpx; }
.image-picker-copy { flex: 1; min-width: 0; }
.image-picker-title { display: block; font-size: 25rpx; font-weight: 750; line-height: 1.45; }
.image-picker-note { display: block; color: var(--muted); font-size: 21rpx; line-height: 1.4; margin-top: 8rpx; }
.image-picker:active { opacity: .72; transform: scale(.992); }

.image-preview-wrap {
  position: relative;
  overflow: hidden;
  width: 100%;
  height: 360rpx;
  border-radius: 26rpx;
  background: #f1e8de;
}

.image-preview { width: 100%; height: 100%; }
.image-preview-wrap::after { content: ""; position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: linear-gradient(180deg, transparent 58%, rgba(36, 27, 20, .44)); pointer-events: none; }
.image-preview-actions { position: absolute; z-index: 2; right: 18rpx; bottom: 18rpx; display: flex; gap: 10rpx; }
.image-action { min-width: 96rpx; min-height: 56rpx; padding: 0 20rpx; border-radius: 999rpx; font-size: 22rpx; line-height: 56rpx; }
.image-action.replace { background: rgba(255, 253, 249, .94); color: var(--ink); }
.image-action.remove { background: rgba(64, 49, 39, .82); color: white; }
.image-hint { margin: 10rpx 4rpx 0; }

.time-field { margin-bottom: 28rpx; }

.time-control {
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: 100%;
  min-height: 96rpx;
  padding: 10rpx;
  background: #f8f4ee;
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
}

.time-step {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 76rpx;
  width: 76rpx;
  height: 76rpx;
  min-height: 76rpx;
  padding: 0;
  background: var(--paper);
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  color: var(--ink);
  font-size: 34rpx;
  line-height: 76rpx;
}

.time-value {
  display: flex;
  align-items: baseline;
  justify-content: center;
  flex: 1;
  gap: 8rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.time-number {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 800;
}

.ingredient-field { margin-bottom: 0; }

.ingredient-list {
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  background: #f8f4ee;
}

.ingredient-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 160rpx 48rpx;
  align-items: center;
  gap: 10rpx;
  min-height: 94rpx;
  padding: 12rpx;
  border-bottom: 1rpx solid var(--line);
}

.ingredient-row:last-child { border-bottom: 0; }

.ingredient-name {
  width: 100%;
  height: 68rpx;
  padding: 0 14rpx;
  background: var(--paper);
  border-radius: 15rpx;
}

.ingredient-amount {
  display: flex;
  align-items: center;
  height: 68rpx;
  overflow: hidden;
  background: var(--paper);
  border-radius: 15rpx;
}

.quantity-input {
  width: 58rpx;
  height: 68rpx;
  padding-left: 12rpx;
  text-align: center;
  font-weight: 750;
}

.unit-picker {
  min-width: 76rpx;
  padding: 0 8rpx;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 68rpx;
  text-align: center;
}

.ingredient-remove {
  width: 48rpx;
  height: 48rpx;
  min-height: 48rpx;
  padding: 0;
  background: transparent;
  color: #aa9d93;
  font-size: 34rpx;
  line-height: 48rpx;
}

.add-ingredient {
  width: 100%;
  margin-top: 16rpx;
  min-height: 76rpx;
  padding: 0;
  background: transparent;
  border: 1rpx dashed #d7c8bc;
  border-radius: 18rpx;
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 750;
  line-height: 76rpx;
}

.ingredient-hint { margin: 14rpx 4rpx 0; line-height: 1.55; }

.step-field { margin-bottom: 0; }

.step-list {
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  background: #f8f4ee;
}

.step-edit-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 18rpx 14rpx;
  border-bottom: 1rpx solid var(--line);
}

.step-edit-row:last-child { border-bottom: 0; }

.step-edit-number {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 54rpx;
  width: 54rpx;
  height: 54rpx;
  margin-top: 4rpx;
  border-radius: 18rpx;
  background: var(--accent-soft);
  color: var(--accent);
  font-weight: 800;
}

.step-input {
  flex: 1;
  width: auto;
  min-height: 76rpx;
  padding: 12rpx 14rpx;
  background: var(--paper);
  border-radius: 15rpx;
  line-height: 1.55;
}

.step-remove {
  flex: 0 0 48rpx;
  width: 48rpx;
  height: 48rpx;
  min-height: 48rpx;
  padding: 0;
  background: transparent;
  color: #aa9d93;
  font-size: 34rpx;
  line-height: 48rpx;
}

.add-step {
  width: 100%;
  min-height: 76rpx;
  margin-top: 16rpx;
  padding: 0;
  background: transparent;
  border: 1rpx dashed #d7c8bc;
  border-radius: 18rpx;
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 750;
  line-height: 76rpx;
}
