.time-field { margin-bottom: 28rpx; }

.time-control {
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: 100%;
  min-height: 96rpx;
  padding: 10rpx;
  background: #f8f4ee;
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
}

.time-step {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 76rpx;
  width: 76rpx;
  height: 76rpx;
  min-height: 76rpx;
  padding: 0;
  background: var(--paper);
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  color: var(--ink);
  font-size: 34rpx;
  line-height: 76rpx;
}

.time-value {
  display: flex;
  align-items: baseline;
  justify-content: center;
  flex: 1;
  gap: 8rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.time-number {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 800;
}

.ingredient-field { margin-bottom: 0; }

.ingredient-list {
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  background: #f8f4ee;
}

.ingredient-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 160rpx 48rpx;
  align-items: center;
  gap: 10rpx;
  min-height: 94rpx;
  padding: 12rpx;
  border-bottom: 1rpx solid var(--line);
}

.ingredient-row:last-child { border-bottom: 0; }

.ingredient-name {
  width: 100%;
  height: 68rpx;
  padding: 0 14rpx;
  background: var(--paper);
  border-radius: 15rpx;
}

.ingredient-amount {
  display: flex;
  align-items: center;
  height: 68rpx;
  overflow: hidden;
  background: var(--paper);
  border-radius: 15rpx;
}

.quantity-input {
  width: 58rpx;
  height: 68rpx;
  padding-left: 12rpx;
  text-align: center;
  font-weight: 750;
}

.unit-picker {
  min-width: 76rpx;
  padding: 0 8rpx;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 68rpx;
  text-align: center;
}

.ingredient-remove {
  width: 48rpx;
  height: 48rpx;
  min-height: 48rpx;
  padding: 0;
  background: transparent;
  color: #aa9d93;
  font-size: 34rpx;
  line-height: 48rpx;
}

.add-ingredient {
  width: 100%;
  margin-top: 16rpx;
  min-height: 76rpx;
  padding: 0;
  background: transparent;
  border: 1rpx dashed #d7c8bc;
  border-radius: 18rpx;
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 750;
  line-height: 76rpx;
}

.ingredient-hint { margin: 14rpx 4rpx 0; line-height: 1.55; }

.step-field { margin-bottom: 0; }

.step-list {
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  background: #f8f4ee;
}

.step-edit-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 18rpx 14rpx;
  border-bottom: 1rpx solid var(--line);
}

.step-edit-row:last-child { border-bottom: 0; }

.step-edit-number {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 54rpx;
  width: 54rpx;
  height: 54rpx;
  margin-top: 4rpx;
  border-radius: 18rpx;
  background: var(--accent-soft);
  color: var(--accent);
  font-weight: 800;
}

.step-input {
  flex: 1;
  width: auto;
  min-height: 76rpx;
  padding: 12rpx 14rpx;
  background: var(--paper);
  border-radius: 15rpx;
  line-height: 1.55;
}

.step-remove {
  flex: 0 0 48rpx;
  width: 48rpx;
  height: 48rpx;
  min-height: 48rpx;
  padding: 0;
  background: transparent;
  color: #aa9d93;
  font-size: 34rpx;
  line-height: 48rpx;
}

.add-step {
  width: 100%;
  min-height: 76rpx;
  margin-top: 16rpx;
  padding: 0;
  background: transparent;
  border: 1rpx dashed #d7c8bc;
  border-radius: 18rpx;
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 750;
  line-height: 76rpx;
}
