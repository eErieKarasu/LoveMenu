<view class="screen">
  <view class="page-header">
    <view><text class="title">一周菜单规划</text></view>
    <button class="round-btn" bindtap="regenerate">↻</button>
  </view>
  <view wx:if="{{loading}}" class="loading">正在生成一周菜单…</view>
  <view wx:elif="{{!hasRecipes}}" class="empty-state">
    <text class="headline">还没有可安排的菜谱</text>
    <text>先记录几道家常菜，再回来生成一周菜单。</text>
    <button class="primary" style="margin-top: 28rpx" bindtap="goRecipes">去添加菜谱</button>
  </view>
  <block wx:else>
    <scroll-view scroll-x class="date-strip">
      <button wx:for="{{weekPlan}}" wx:key="key" class="date-pill {{selectedDay === index ? 'active' : ''}}" data-index="{{index}}" bindtap="selectDay"><text>{{item.week}}</text><text class="day">{{item.day}}</text></button>
    </scroll-view>
    <view class="balance-card"><text>平衡提醒：一周里尽量穿插鱼类、绿叶菜和清淡汤菜。右上角可以随时换一套安排。</text></view>
    <view class="card meal-block"><view class="meal-heading"><text class="name">早餐</text><text class="count">{{selected.meals.breakfast.length}} 道</text></view><view class="meal-items"><text class="meal-item" wx:for="{{selected.meals.breakfast}}" wx:key="*this">{{item}}</text></view></view>
    <view class="card meal-block"><view class="meal-heading"><text class="name">午餐</text><text class="count">{{selected.meals.lunch.length}} 道</text></view><view class="meal-items"><text class="meal-item" wx:for="{{selected.meals.lunch}}" wx:key="*this">{{item}}</text></view></view>
    <view class="card meal-block"><view class="meal-heading"><text class="name">晚餐</text><text class="count">{{selected.meals.dinner.length}} 道</text></view><view class="meal-items"><text class="meal-item" wx:for="{{selected.meals.dinner}}" wx:key="*this">{{item}}</text></view></view>
  </block>
</view>
